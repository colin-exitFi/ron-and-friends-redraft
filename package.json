{
  "name": "ron-and-friends-redraft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pull:room": "node scripts/smartdraft-pull.mjs",
    "diff:room": "node scripts/smartdraft-diff.mjs",
    "pull:sleeper": "node scripts/sleeper-pull.mjs",
    "build:board": "node --experimental-strip-types --no-warnings scripts/build-board.mjs",
    "verify:keepers": "node --experimental-strip-types --no-warnings --import ./scripts/ts-alias.mjs scripts/verify-keeper-clock.mts",
    "verify:draft": "node --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/simulate-draft.mts",
    "verify:draft:dryrun": "node scripts/verify-draft-dryrun.mjs",
    "verify:draft:typing": "node scripts/verify-draft-typing.mjs",
    "verify:draft:arrows": "node scripts/verify-draft-arrows.mjs",
    "verify:draft:delete": "node scripts/verify-draft-delete.mjs",
    "verify:board:fit": "node --experimental-strip-types --no-warnings scripts/verify-board-fit.mjs",
    "verify:tv": "node --experimental-strip-types --no-warnings scripts/verify-tv-follow.mjs",
    "verify:final:fit": "node scripts/verify-final-board-fit.mjs",
    "verify:roster:pane": "node scripts/verify-roster-pane.mjs",
    "verify:roster:wall": "node --experimental-strip-types --no-warnings scripts/verify-roster-wall.mjs",
    "verify:mock": "node --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/verify-mock-isolation.mts",
    "verify:mock:browser": "node scripts/verify-mock-browser.mjs",
    "verify:draft:realtime": "node --env-file=.env.local scripts/verify-draft-realtime.mjs",
    "verify:draft:remote": "node --env-file=.env.local scripts/verify-draft-two-clients.mjs",
    "pull:players": "node scripts/smartdraft-players.mjs",
    "auth:fantasypros": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/fantasypros-auth.mjs",
    "pull:fantasypros": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/fantasypros-players.mjs",
    "reset:fantasypros": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/fantasypros-reset.mjs",
    "diff:fantasypros": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/fantasypros-diff.mjs",
    "whoami:fantasypros": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/fantasypros-whoami.mjs",
    "verify:fantasypros": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/verify-fantasypros.mts",
    "verify:fantasypros:banner": "node scripts/verify-fantasypros-banner.mjs",
    "pull:projections": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/fantasypros-pull.mjs",
    "verify:projections": "node --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/verify-projected-standings.mts",
    "db:apply:redraft": "node scripts/apply-redraft-schema.mjs",
    "db:push": "node -e \"console.error('\\n  DO NOT PUSH MIGRATIONS FROM THIS REPO.\\n\\n  The ron-and-friends-ff project has a migration ledger in\\n  supabase_migrations.schema_migrations owned by ../RonAndFriendsApp.\\n  Pushing this repo\\'s migrations into it would leave THAT repo unable to\\n  push again \u2014 it would see remote versions with no local files.\\n\\n  Apply the schema instead:  npm run db:apply:redraft\\n  Reasoning:                 supabase/redraft-schema.sql (header)\\n'); process.exit(1)\"",
    "db:seed": "node --experimental-strip-types --no-warnings scripts/seed-league.mjs",
    "db:seed:dry": "node --experimental-strip-types --no-warnings scripts/seed-league.mjs --dry-run",
    "db:types": "supabase gen types typescript --project-id opxyeajywipsitwecgcz --schema redraft",
    "db:verify": "node --experimental-strip-types --no-warnings --import ./scripts/seed-verify-loader.mjs scripts/seed-verify-pages.mts",
    "db:import:draft": "node --experimental-strip-types --no-warnings --import ./scripts/seed-verify-loader.mjs scripts/seed-import-draft.mts",
    "db:verify:import": "node --experimental-strip-types --no-warnings --import ./scripts/seed-verify-loader.mjs scripts/seed-verify-import.mts",
    "db:verify:trades": "node --experimental-strip-types --no-warnings --import ./scripts/seed-verify-loader.mjs scripts/seed-verify-trades.mts",
    "verify:board-keepers": "node --experimental-strip-types --no-warnings --import ./scripts/seed-verify-loader.mjs scripts/seed-verify-board-keepers.mts",
    "verify:round1": "node --experimental-strip-types --no-warnings --import ./scripts/seed-verify-loader.mjs scripts/seed-verify-round1.mts",
    "verify:tenure": "node --experimental-strip-types --no-warnings --import ./scripts/seed-verify-loader.mjs scripts/seed-verify-tenure.mts",
    "audit:tenure": "node --experimental-strip-types --no-warnings --import ./scripts/seed-verify-loader.mjs scripts/seed-audit-tenure.mts",
    "verify:picks": "node scripts/seed-dump-db-picks.mjs && python3 scripts/seed-verify-traded-picks.py",
    "verify:trade-entry": "node --experimental-strip-types --no-warnings --import ./scripts/seed-verify-loader.mjs scripts/verify-trade-entry.mts",
    "verify:expected": "node --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/verify-expected-pick.mts",
    "verify:history": "node scripts/verify-league-history.mjs",
    "verify:draft:notes": "DRAFT_STORE=database node --env-file=.env.local --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/verify-draft-notes.mts",
    "verify:recap": "node --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/verify-recap.mts",
    "verify:recap:clean": "node --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/verify-recap-clean.mts",
    "verify:recap:browser": "node scripts/verify-recap-browser.mjs",
    "audit:recap:layout": "node scripts/audit-recap-layout.mjs",
    "audit:nav:pane": "node scripts/audit-nav-pane.mjs",
    "verify:recap:spread": "node --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/verify-recap-spread.mts",
    "verify:recap:grade": "node --env-file-if-exists=.env.local --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/verify-recap-grade.mts",
    "verify:recap:db": "RECAP_STORE=database node --env-file=.env.local --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/verify-recap-db.mts",
    "experiment:recap": "node --env-file=.env.local --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/experiment-recap-voice.mts",
    "sync:history-keepers": "node --experimental-strip-types --no-warnings --import ./scripts/draft-loader.mjs scripts/sync-history-keeper-values.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
