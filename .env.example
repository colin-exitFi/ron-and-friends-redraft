# Ron and Friends - environment template (safe to commit; fill real values in .env.local)
#
# The draft board and the player pool read local JSON and need NONE of this.
# Everything below is for the deployed instance, where picks go to Postgres
# because a deployment has no writable disk.
#
# ============================================================================
# WHICH DATABASE THIS IS
# ============================================================================
# The Ron & Friends project (`ron-and-friends-ff`, ref opxyeajywipsitwecgcz),
# schema `redraft`.
#
# NOT `ultimate-keeper-league` / xqhkhcmphvytoibjewqi. This tree is a copy of
# that app and shipped pointing at it; that project holds a real completed
# draft and must never be written to from here.
#
# NOT the `public` schema either. The R&F project is SHARED with the deployed
# app at ron-and-friends-fantasy.vercel.app, whose backend IS `public` —
# ballots managers have already voted in, the treasury ledger, the lottery.
# The two schemas collide on fourteen table names (leagues, teams, trades,
# draft_state, votes, keepers and more), so a Supabase client that loses its
# schema option does not error, it silently reads the other league's rows.
#
# The schema name lives in code, not here: src/lib/db-schema.mjs.
# `redraft` must also be in the project's exposed-schemas list
# (Settings -> API -> Exposed schemas) or every query returns 404.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# For direct Postgres connections (`npm run db:apply:redraft`).
#
# NOT for `supabase db push` or `supabase link`. The migration ledger on this
# project belongs to ../RonAndFriendsApp; pushing from here would leave that
# repo unable to push again. The schema is applied as one idempotent script
# instead — see the header of supabase/redraft-schema.sql.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Personal access token (dashboard -> Account -> Tokens). Only needed to read
# or change the exposed-schemas list via the Management API, which is the one
# piece of setup that is a project setting rather than SQL.
SUPABASE_ACCESS_TOKEN=

# Where the live draft board saves: `file` (data/draft-state-<season>.json) or
# `database` (the draft_live_state row). Leave unset — the app picks the file
# when the disk is writable and the database when it is not, which is what a
# deployment always is.
DRAFT_STORE=

# Where the post-draft recap is kept between page loads: `file`
# (data/draft-recap-<season>.json) or `database` (the draft_recap row). Same two
# backends as the draft board and for the same reason. Leave unset — the
# detection matches DRAFT_STORE's.
RECAP_STORE=

# Writes the recap blurbs. Without it the recap tab still renders every number
# it would be arguing from and says in a sentence why there is no prose, so a
# missing key cannot break a page or a build.
ANTHROPIC_API_KEY=

# --- FantasyPros --------------------------------------------------------------
#
# THERE IS NO TOKEN TO PUT HERE, AND THAT IS DELIBERATE. The FantasyPros grant is
# obtained once by running `npm run auth:fantasypros`, which signs the
# commissioner in through a browser and stores a refresh token. It is stored
# server-side rather than in an env var because FantasyPros may rotate it on any
# refresh, and a rotated token has to be written back by the running app — an
# env var would need a redeploy, and a push here is a production release.
#
# Where that grant is kept: `file` (.local/fantasypros-oauth.json, gitignored)
# or `database` (the fantasypros_oauth row, which has no read policy so the
# browser's anon key cannot reach it). Leave unset — the database wins wherever
# Supabase is configured, so the laptop and the deployment share one grant.
FANTASYPROS_TOKEN_STORE=

# Lets `npm run verify:fantasypros` and the /api/fantasypros/refresh route be
# called by Vercel Cron and by the commissioner without being open to the world.
# Any long random string; `openssl rand -hex 32` is fine. Optional — with it
# unset the refresh route still works, it is just unauthenticated like the draft
# routes next to it.
FANTASYPROS_REFRESH_SECRET=
